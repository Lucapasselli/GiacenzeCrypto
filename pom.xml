<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.giacenzecrypto</groupId>
    <artifactId>Giacenze_Crypto</artifactId>
    <version>1.0.65.13</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <exec.mainClass>com.giacenzecrypto.giacenze_crypto.Giacenze_Crypto</exec.mainClass>
        <!-- Edizione con cui costruire il jar, scritta in version.properties dal resource filtering e
             letta da VarStatiche.EdizioneStore(). "completa" è tutto il programma; "store" toglie lo
             scaricamento dai conti exchange e i loghi di terzi, che il Microsoft Store non consente a un
             account Individual (vedi nocommit/Documentazione/Pubblicazione_MicrosoftStore.md).
             Build per lo Store:  mvn clean package -DskipTests -Dgiacenze.edizione=store  -->
        <giacenze.edizione>completa</giacenze.edizione>
    </properties>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.9.3</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.formdev/flatlaf -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.4</version>
            <type>jar</type>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.12.1</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.toedter/jcalendar -->
        <dependency>
            <groupId>com.toedter</groupId>
            <artifactId>jcalendar</artifactId>
            <version>1.4</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.json/json -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20250107</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.github.librepdf/openpdf -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.3</version>
        </dependency>

        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel</artifactId>
            <version>0.18.4</version>
            <type>jar</type>
        </dependency>
	 
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>
        <!-- Solo per i test (Keccak-256 in Trans_XLayerTest). Nel programma non serve piu' dal 2026-10-22:
             bitcoinj, che lo portava nel jar con guava e protobuf (14 MB), e' stato sostituito da
             IndirizziBitcoin. OpenPDF lo userebbe solo per i PDF cifrati con AES, che il programma non legge. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15to18</artifactId>
            <version>1.73</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.13.1</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>3.6</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Solo per i test: valida le configurazioni di import contro docs/schema/configurazione-import.schema.json -->
        <dependency>
            <groupId>com.github.erosb</groupId>
            <artifactId>everit-json-schema</artifactId>
            <version>1.14.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- Solo version.properties viene filtrato, per sostituire ${project.version}:
                 le altre risorse sono immagini binarie e il filtering le corromperebbe -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/version.properties</exclude>
                </excludes>
            </resource>
            <!-- Le mappe causali degli import nativi vivono in config/importmappe/ (da dove vengono
                 sincronizzate con il repository) e vengono incluse nel jar come copia di default:
                 MappeCausali.InstallaDefaultSeMancanti() le estrae al primo avvio, anche offline.
                 Un'unica sorgente, nessuna copia da tenere allineata a mano. -->
            <resource>
                <directory>config/importmappe</directory>
                <targetPath>ImportMappe</targetPath>
                <includes>
                    <include>*.json</include>
                </includes>
            </resource>
            <!-- Idem per config/varie/ (note di compilazione dei quadri): copia di default in /Varie/ -->
            <resource>
                <directory>config/varie</directory>
                <targetPath>Varie</targetPath>
                <includes>
                    <include>*.json</include>
                </includes>
            </resource>
            <!-- Le novita' delle versioni (docs/documentazione/changelog.md, la pagina pubblicata su GitHub Pages)
                 vanno anche nel jar: NovitaVersione ne mostra la sezione della versione al primo avvio dopo un
                 aggiornamento, senza rete. Un'unica sorgente per la pagina e per il dialogo. -->
            <resource>
                <directory>docs/documentazione</directory>
                <targetPath>Novita</targetPath>
                <includes>
                    <include>changelog.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Aggiungi queste due configurazioni -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>jar-with-dependencies</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.giacenzecrypto.giacenze_crypto.Giacenze_Crypto</mainClass>
                                    <!-- Splash nativo AWT mostrato dalla JVM prima dell'avvio di Swing:
                                         SplashAvvio.splashNativo() lo recupera con SplashScreen.getSplashScreen(),
                                         che senza questa voce nel manifest restituisce null -->
                                    <manifestEntries>
                                        <SplashScreen-Image>splash.png</SplashScreen-Image>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>