    <Component class="javax.swing.JLabel" name="Label_Info">
      <Properties>
        <Property name="text" type="java.lang.String" value="&lt;html&gt;Un rigo per periodo, distinto CRYPTO / FIAT. Data inizio vuota = dedotta dal primo movimento (in una fase successiva). Data fine obbligatoria solo se il conto e' stato chiuso. Un valore iniziale/finale inserito a mano prevale sul calcolo automatico : la nota serve a spiegarne il motivo.&lt;/html&gt;"/>
      </Properties>
    </Component>
