      <SubComponents>
        <Component class="javax.swing.JTextPane" name="TextPane_Attenzione">
          <Properties>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="contentType" type="java.lang.String" value="text/html" noResource="true"/>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="Noto Sans" size="14" style="0"/>
            </Property>
            <Property name="text" type="java.lang.String" value="&lt;html&gt;&#xa;&lt;head&gt;&#xa;&lt;style&gt;&#xa;  body {&#xa;    font-family: &apos;Noto Sans&apos;, Arial, sans-serif;&#xa;    font-size: 13px;&#xa;    margin: 10px 14px;&#xa;    line-height: 1.6;&#xa;  }&#xa;  p { margin: 5px 0; }&#xa;  b { font-weight: bold; }&#xa;  .mono {&#xa;    font-family: monospace;&#xa;    font-size: 12px;&#xa;    font-weight: bold;&#xa;  }&#xa;  ul {&#xa;    margin: 6px 0 4px 18px;&#xa;    padding: 0;&#xa;  }&#xa;  li { margin-bottom: 3px; }&#xa;&lt;/style&gt;&#xa;&lt;/head&gt;&#xa;&lt;body&gt;&#xa;&#xa;&lt;p&gt;&lt;b&gt;Attenzione &lt;br&gt;&#xa;Importazione da cointracking.info o Tatax&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p&gt;Per una corretta importazione &amp;egrave; necessario:&lt;/p&gt;&#xa;&#xa;&lt;ul&gt;&#xa;  &lt;li&gt;Importare i dati &lt;b&gt;un solo exchange / wallet per volta&lt;/b&gt;&lt;/li&gt;&#xa;  &lt;li&gt;Impostare il &lt;b&gt;nome dell&amp;#39;exchange o wallet&lt;/b&gt; nel campo sottostante&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&#xa;&lt;p&gt;&lt;i&gt;Esempio:&lt;/i&gt; &amp;nbsp;&lt;span class=&quot;mono&quot;&gt;Binance&lt;/span&gt;&lt;/p&gt;&#xa;&#xa;&lt;/body&gt;&#xa;&lt;/html&gt;&#xa;"/>
            <Property name="enabled" type="boolean" value="false"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
